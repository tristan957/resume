{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "projects.json",
  "title": "Projects",
  "description": "Notable projects listed on the resume",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "descriptors"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "description": "Name of the project"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "description": "URL of the project's repository or website"
      },
      "icon": {
        "type": "string",
        "description": "FontAwesome icon name for the project"
      },
      "descriptors": {
        "type": "array",
        "description": "Bullet-point descriptions of the project",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    }
  }
}
