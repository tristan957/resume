{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "skills.json",
  "title": "Skills",
  "description": "Technical skills listed on the resume",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "description": "Name of the skill"
      }
    }
  },
  "minItems": 1,
  "uniqueItems": true
}
